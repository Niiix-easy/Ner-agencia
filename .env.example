# GEMINI_API_KEY: Required for Gemini AI API calls in NER Strategy.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Database & Cache (Optional for local atomic JSON persistence; required for PostgreSQL/Redis Docker stack)
DATABASE_URL="postgresql://ner_admin:ner_secure_password@localhost:5432/ner_agency_os"
REDIS_URL="redis://localhost:6379"

# Dev bootstrap password for seeded demo accounts (override in non-local environments)
NER_DEV_BOOTSTRAP_PASSWORD="NerAgency@2026"

# Google Sign-In (Google Identity Services - client-side OAuth popup + server-side token verification)
GOOGLE_CLIENT_ID=""
GOOGLE_AUTH_ALLOW_AUTO_PROVISION="false"
GOOGLE_AUTH_DEFAULT_ROLE="Criativo"

# Stripe Billing & Webhook verification (required for live Stripe checkout & webhook validation)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# External Integrations (Pending credentials until configured)
N8N_WEBHOOK_URL=""
META_APP_ID=""
META_APP_SECRET=""
GOOGLE_ADS_CLIENT_ID=""

# ==========================================
# NER AI GATEWAY (Centralized AI Infrastructure)
# ==========================================
# Chave mestra para criptografia AES-256-GCM das credenciais salvas no painel (mín. 32 bytes / 64 hex)
NER_AI_ENCRYPTION_KEY=""

# Provedores Nuvem & Roteadores
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
GOOGLE_AI_API_KEY=""
OPENROUTER_API_KEY=""
HUGGINGFACE_API_TOKEN=""

# Modelos Locais & Self-Hosted
OLLAMA_BASE_URL="http://localhost:11434"
VLLM_BASE_URL=""
VLLM_API_KEY=""

