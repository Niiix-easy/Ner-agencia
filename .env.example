# ==============================================================================
# NER AGENCY OS / NER AI CENTER — Production Environment Configuration
# Copy to .env and populate secrets securely (never commit real secrets).
# ==============================================================================

# Application URL (used for Stripe Checkout redirects, reset links, and SSR pages)
APP_URL="http://localhost:3000"
NODE_ENV="development"

# ==========================================
# DATABASE & QUEUE (PostgreSQL + Prisma + Redis)
# ==========================================
# Primary PostgreSQL connection URL (Cloud SQL, Managed PG, Supabase/Neon, Lovable Cloud PG, or Self-Hosted)
DATABASE_URL="postgresql://ner_admin:CHANGE_ME@localhost:5432/ner_agency_os?schema=public"
# Optional non-pooled direct connection URL for Prisma migrations behind PgBouncer/poolers
DIRECT_URL=""
# Set to "true" or "require" for managed PostgreSQL instances requiring TLS/SSL
DATABASE_SSL="false"
DATABASE_SSL_REJECT_UNAUTHORIZED="true"
# Connection pool tuning
PG_POOL_MAX="10"
PG_IDLE_TIMEOUT_MS="30000"
PG_CONNECT_TIMEOUT_MS="10000"
# Emergency fallback flag (set "true" only to force local JSON store temporarily)
NER_FORCE_JSON_STORE="false"
# Required for distributed rate limiting & BullMQ job queue
REDIS_URL="redis://localhost:6379"

# ==========================================
# AUTHENTICATION & PASSWORD RECOVERY
# ==========================================
# Dev bootstrap password for local seeded demo accounts (never use in production)
NER_DEV_BOOTSTRAP_PASSWORD="NerAgency@2026"

# Google Sign-In (Google Identity Services — client-side popup + server-side token verification)
GOOGLE_CLIENT_ID=""
GOOGLE_AUTH_ALLOW_AUTO_PROVISION="false"
GOOGLE_AUTH_DEFAULT_ROLE="Criativo"

# Transactional Email (Resend) for password recovery & notifications
RESEND_API_KEY=""
MAIL_FROM="NER Agency OS <no-reply@neragency.com>"

# ==========================================
# STRIPE BILLING & SUBSCRIPTIONS
# ==========================================
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Optional Stripe Price IDs mapped by internal planCode (e.g. STRIPE_PRICE_NER_BUSINESS_PRO)
STRIPE_PRICE_NER_LP_EXPRESS=""
STRIPE_PRICE_NER_LP_PRO=""
STRIPE_PRICE_NER_SITE_PRO=""
STRIPE_PRICE_NER_ECOMMERCE_PRO=""
STRIPE_PRICE_NER_BUSINESS_GROWTH=""
STRIPE_PRICE_NER_BUSINESS_PRO=""

# ==========================================
# OBJECT STORAGE (S3 / Cloudflare R2 / GCS / MinIO)
# ==========================================
STORAGE_SIGNING_SECRET=""
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

